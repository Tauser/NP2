{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NP2 Offline Snapshot v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "origin", "weather", "market"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "origin": { "enum": ["cache", "live"] },
    "weather": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "stale"],
      "allOf": [
        {
          "if": { "properties": { "available": { "const": true } }, "required": ["available"] },
          "then": {
            "required": ["temperatureDeciC", "relativeHumidityPercent", "weatherCode", "observedAtUnixS"]
          }
        }
      ],
      "properties": {
        "available": { "type": "boolean" },
        "stale": { "type": "boolean" },
        "temperatureDeciC": { "type": "integer", "minimum": -1000, "maximum": 1000 },
        "relativeHumidityPercent": { "type": "integer", "minimum": 0, "maximum": 100 },
        "weatherCode": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "observedAtUnixS": { "type": "integer", "minimum": 1 }
      }
    },
    "market": {
      "type": "object",
      "additionalProperties": false,
      "required": ["available", "stale"],
      "allOf": [
        {
          "if": { "properties": { "available": { "const": true } }, "required": ["available"] },
          "then": {
            "required": ["bitcoinUsdCents", "change24hBasisPoints", "observedAtUnixS"]
          }
        }
      ],
      "properties": {
        "available": { "type": "boolean" },
        "stale": { "type": "boolean" },
        "bitcoinUsdCents": { "type": "integer", "minimum": 0, "maximum": 4294967295 },
        "change24hBasisPoints": { "type": "integer", "minimum": -32768, "maximum": 32767 },
        "observedAtUnixS": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
