CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x10000
CONFIG_SPIRAM=y
# Phase 2 experimental image: run flash .text/.rodata from PSRAM so an SPI1
# write/erase does not disable the cache. This remains gated by physical
# validation of display, NVS erase/GC and OTA; it is not a product baseline.
CONFIG_SPIRAM_XIP_FROM_PSRAM=y

# Weather backgrounds on the microSD use descriptive names such as
# np_bg_day_partly_cloudy.bin. Keep the FAT long-name buffer bounded and off
# service task stacks while preserving those names on the card.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=32768
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_DRAW_BUF_ALIGN=64
CONFIG_LV_DRAW_BUF_STRIDE_ALIGN=64
CONFIG_BSP_LCD_DPI_BUFFER_NUMS=3
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
# Keep the internal TLS RX allocation below the measured 15 KiB contiguous
# heap block while preserving streaming of larger HTTP response bodies.
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=8192
CONFIG_MBEDTLS_INTERNAL_MEM_ALLOC=y
# ESP32-P4 mbedTLS AES-DMA allocation fails during the eWeLink response read
# under the real UI/network heap profile. Keep TLS allocations internal and
# use the constant-time software AES implementation until DMA heap behavior
# is measured and the accelerated path is validated on the board.
CONFIG_MBEDTLS_HARDWARE_AES=n
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=n
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOST_WIFI_ENABLED=n
CONFIG_ESP_HOSTED_HOST_FEAT_WIFI_EXT_ITWT=n
# Keep aligned ESP-Hosted SDIO buffers out of scarce internal DMA heap during
# TLS traffic. ESP32-P4 EDMA supports aligned DMA buffers in external PSRAM;
# the component allocator falls back to internal DMA RAM when needed.
CONFIG_EH_HOST_PORT_DMA_PREFER_SPIRAM=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_FUNC_BOARD=y
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_LOW=y
# A runtime SDIO failure must degrade networking locally, never restart P4.
# CONFIG_ESP_HOSTED_HOST_TRANSPORT_RESTART_ON_FAILURE is not set
# Do not use flash suspend on JEDEC 0xC84019. It has produced a boot loop on
# this board and is independent from the XiP experiment above.
CONFIG_SPI_FLASH_AUTO_SUSPEND=n
CONFIG_LV_MEM_POOL_EXPAND_SIZE_KILOBYTES=128
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
